@model System.Collections.Generic.IReadOnlyList<Credential>
@{
    ViewData["Title"] = "Credenciales";
    ViewData["Nav"] = "Credentials";
    string VText(SnmpVersion v) => v == SnmpVersion.V3 ? "SNMPv3" : (v == SnmpVersion.V1 ? "SNMPv1" : "SNMPv2c");
}

@if (TempData["Message"] is string msg)
{
    <div class="noc-card" style="border-color:var(--noc-green);"><div style="color:var(--noc-green);">@msg</div></div>
}
@if (TempData["Error"] is string err)
{
    <div class="noc-card" style="border-color:var(--noc-red);"><div style="color:var(--noc-red);">@err</div></div>
}

<div class="noc-toolbar">
    <h2 class="mb-0">Credenciales SNMP</h2>
    <button type="button" class="noc-btn noc-btn-sm" data-bs-toggle="modal" data-bs-target="#newV2cModal">+ SNMPv2c</button>
    <button type="button" class="noc-btn noc-btn-sm" data-bs-toggle="modal" data-bs-target="#newV3Modal">+ SNMPv3</button>
</div>

@if (Model.Count == 0)
{
    <div class="noc-empty"><div class="noc-empty-icon">⛉</div><p>No hay credenciales registradas.</p></div>
}
else
{
    <div class="noc-table-wrap">
        <table class="noc-table">
            <thead><tr><th>Nombre</th><th>Versión</th><th>Usuario</th><th>Protocolos</th><th>Estado</th><th>Vence</th><th style="text-align:right;">Acciones</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@VText(c.Version)</td>
                        <td>@(c.Version == SnmpVersion.V3 ? (c.UserName ?? "—") : "—")</td>
                        <td>@(c.Version == SnmpVersion.V3 ? $"{c.AuthProtocol}/{c.PrivProtocol}" : "—")</td>
                        <td>
                            @if (c.CanUse) { <span class="noc-badge Success">Activa</span> }
                            else if (!c.IsActive) { <span class="noc-badge">Desactivada</span> }
                            else { <span class="noc-badge Warning">Expirada</span> }
                        </td>
                        <td>@(c.ExpiresAt.HasValue ? UiDisplay.FormatDateTime(c.ExpiresAt) : "—")</td>
                        <td style="text-align:right; white-space:nowrap;" class="noc-row-actions">
                            @if (c.Version == SnmpVersion.V2c && c.IsActive)
                            {
                                <button type="button" class="danger" data-bs-toggle="modal" data-bs-target="#rotateV2cModal" data-id="@c.Id.Value" data-name="@c.Name">Rotar</button>
                            }
                            @if (c.IsActive)
                            {
                                <form asp-area="" asp-controller="Administration" asp-action="DeactivateCredential" asp-route-id="@c.Id.Value" method="post" asp-antiforgery="true"
                                      onsubmit="return confirm('¿Desactivar la credencial @c.Name?');" style="display:inline;">
                                    <button type="submit" class="danger">Desactivar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Create V2c *@
<div class="modal fade" id="newV2cModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content" style="background:var(--noc-surface); color:var(--noc-text); border:1px solid var(--noc-border);">
        <form asp-area="" asp-controller="Administration" asp-action="CreateV2c" method="post" class="noc-form" style="padding:16px;">
            <div class="modal-header" style="border-bottom:1px solid var(--noc-border);"><h5 class="modal-title">Nueva credencial SNMPv2c</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <div class="modal-body">
                <label>Nombre</label><input type="text" name="Name" maxlength="100" required />
                <label>Community string</label><input type="password" name="Community" maxlength="200" autocomplete="new-password" required />
                <label>Vence (opcional)</label><input type="datetime-local" name="ExpiresAt" />
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--noc-border);"><button type="button" class="noc-btn" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="noc-btn noc-btn-primary">Crear</button></div>
        </form>
    </div></div>
</div>

@* Create V3 *@
<div class="modal fade" id="newV3Modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content" style="background:var(--noc-surface); color:var(--noc-text); border:1px solid var(--noc-border);">
        <form asp-area="" asp-controller="Administration" asp-action="CreateV3" method="post" class="noc-form" style="padding:16px;">
            <div class="modal-header" style="border-bottom:1px solid var(--noc-border);"><h5 class="modal-title">Nueva credencial SNMPv3</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <div class="modal-body">
                <label>Nombre</label><input type="text" name="Name" maxlength="100" required />
                <label>Usuario</label><input type="text" name="UserName" maxlength="100" required />
                <label>Protocolo de autenticación</label>
                <select name="AuthProtocol"><option value="SHA">SHA</option><option value="MD5">MD5</option></select>
                <label>Contraseña de autenticación</label><input type="password" name="AuthPassword" minlength="8" maxlength="256" autocomplete="new-password" required />
                <label>Protocolo de privacidad</label>
                <select name="PrivProtocol"><option value="DES">DES</option><option value="AES">AES</option></select>
                <label>Contraseña de privacidad</label><input type="password" name="PrivPassword" minlength="8" maxlength="256" autocomplete="new-password" required />
                <label>Vence (opcional)</label><input type="datetime-local" name="ExpiresAt" />
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--noc-border);"><button type="button" class="noc-btn" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="noc-btn noc-btn-primary">Crear</button></div>
        </form>
    </div></div>
</div>

@* Rotate V2c *@
<div class="modal fade" id="rotateV2cModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content" style="background:var(--noc-surface); color:var(--noc-text); border:1px solid var(--noc-border);">
        <form id="rotateV2cForm" asp-area="" asp-controller="Administration" method="post" class="noc-form" style="padding:16px;">
            <div class="modal-header" style="border-bottom:1px solid var(--noc-border);"><h5 class="modal-title">Rotar community</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <div class="modal-body">
                <p class="text-secondary" style="font-size:13px;" id="rotateV2cName"></p>
                <input type="hidden" name="id" id="rotateV2cId" />
                <label>Nuevo community string</label><input type="password" name="newCommunity" autocomplete="new-password" required />
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--noc-border);"><button type="button" class="noc-btn" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="noc-btn noc-btn-primary">Rotar</button></div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script>
        (function () {
            var rotateModal = document.getElementById('rotateV2cModal');
            if (!rotateModal) return;
            rotateModal.addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                var idInput = rotateModal.querySelector('#rotateV2cId');
                var nameSpan = rotateModal.querySelector('#rotateV2cName');
                var form = rotateModal.querySelector('#rotateV2cForm');
                if (btn && idInput) {
                    idInput.value = btn.getAttribute('data-id');
                    nameSpan.textContent = 'Rotar community de "' + btn.getAttribute('data-name') + '".';
                    form.setAttribute('action', '/administration/credentials/' + btn.getAttribute('data-id') + '/rotate-v2c');
                }
            });
        })();
    </script>
}