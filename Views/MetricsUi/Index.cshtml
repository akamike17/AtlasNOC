@model MetricsIndexVm
@{
    ViewData["Title"] = "Métricas";
    ViewData["Nav"] = "Metrics";
}

<div class="noc-toolbar">
    <h2 class="mb-0">Métricas e historial</h2>
</div>

<div class="noc-filters">
    <div class="noc-form">
        <label for="deviceSelect">Dispositivo</label>
        <select id="deviceSelect">
            <option value="">— Seleccione —</option>
            @foreach (var d in Model.Devices)
            {
                <option value="@d.Id.Value" selected="@(Model.SelectedDevice == d.Id.Value)">@d.Name (@d.IpAddress)</option>
            }
        </select>
    </div>
    <div class="noc-form">
        <label for="rangeSelect">Período</label>
        <select id="rangeSelect">
            <option value="1">1 hora</option>
            <option value="6">6 horas</option>
            <option value="24" selected>24 horas</option>
            <option value="72">3 días</option>
            <option value="168">7 días</option>
        </select>
    </div>
    <button type="button" id="metricsLoad" class="noc-btn noc-btn-sm">Cargar</button>
</div>

<div class="noc-card">
    <div id="metricsEmpty" class="noc-empty"><div class="noc-empty-icon">▨</div><p>Seleccione un dispositivo para ver su historial de métricas.</p></div>
    <div id="metricsSkeleton" class="noc-spinner" style="display:none;"></div>
    <div id="metricsError" class="noc-empty" style="display:none;"></div>
    <div id="metricsChart" style="display:none;">
        <h2 class="noc-card-h">Disponibilidad</h2>
        <svg id="svgAvailability" viewBox="0 0 800 200" preserveAspectRatio="none" style="width:100%; height:200px; background:var(--noc-bg-2); border:1px solid var(--noc-border); border-radius:6px;"></svg>
        <h2 class="noc-card-h" style="margin-top:16px;">Latencia (ms)</h2>
        <svg id="svgLatency" viewBox="0 0 800 200" preserveAspectRatio="none" style="width:100%; height:200px; background:var(--noc-bg-2); border:1px solid var(--noc-border); border-radius:6px;"></svg>
        <div class="text-secondary" style="font-size:12px; margin-top:8px;" id="metricsMeta"></div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var deviceEl = document.getElementById('deviceSelect');
            var rangeEl = document.getElementById('rangeSelect');
            var loadBtn = document.getElementById('metricsLoad');

            function draw(series, selector, color, fmt) {
                var svg = document.querySelector(selector);
                var points = series.filter(function (p) { return p !== null && p !== undefined; });
                var n = points.length;
                if (n === 0) { svg.innerHTML = '<text x="10" y="110" fill="#8b98ab" font-size="14">Sin datos</text>'; return; }
                var min = Math.min.apply(null, points), max = Math.max.apply(null, points);
                if (max === min) max = min + 1;
                var W = 800, H = 200, pad = 10;
                var coords = points.map(function (v, i) {
                    var x = pad + (i / (n - 1)) * (W - 2 * pad);
                    var y = H - pad - ((v - min) / (max - min)) * (H - 2 * pad);
                    return x.toFixed(1) + ',' + y.toFixed(1);
                });
                var step = Math.max(1, Math.floor(n / 200));
                var shown = coords.filter(function (_, i) { return i % step === 0; });
                var last = coords.length ? coords[coords.length - 1] : null;
                svg.innerHTML = '<polyline points="' + shown.join(' ') +
                    '" fill="none" stroke="' + color + '" stroke-width="2"/>' +
                    '<circle cx="' + (last ? last.split(',')[0] : 0) + '" cy="' + (last ? last.split(',')[1] : 0) + '" r="3" fill="' + color + '"/>';
            }

            function load() {
                var id = deviceEl.value;
                var empty = document.getElementById('metricsEmpty');
                var skel = document.getElementById('metricsSkeleton');
                var chart = document.getElementById('metricsChart');
                var errEl = document.getElementById('metricsError');
                if (!id) { empty.style.display = 'block'; chart.style.display = 'none'; return; }

                var hours = parseInt(rangeEl.value, 10);
                var to = new Date().toISOString();
                var from = new Date(Date.now() - hours * 3600 * 1000).toISOString();
                empty.style.display = 'none'; chart.style.display = 'none'; errEl.style.display = 'none'; skel.style.display = 'block';

                window.AtlasNoc.request('/metrics/series/' + id + '?from=' + encodeURIComponent(from) + '&to=' + encodeURIComponent(to), {}, { showError: false })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        skel.style.display = 'none';
                        var items = data.items || [];
                        if (!items.length) {
                            errEl.innerHTML = '<div class="noc-empty-icon">▨</div><p>No hay datos de métricas en este período para el dispositivo.</p>';
                            errEl.style.display = 'block';
                            return;
                        }
                        var avail = items.map(function (s) { return s.availabilityPercent; });
                        var lat = items.map(function (s) { return s.latencyMs; });
                        draw(avail, '#svgAvailability', '#39c5cf');
                        draw(lat, '#svgLatency', '#bc8cff');
                        document.getElementById('metricsMeta').textContent =
                            items.length + ' puntos · de ' + new Date(items[0].timestamp).toLocaleString() + ' a ' + new Date(items[items.length - 1].timestamp).toLocaleString();
                        chart.style.display = 'block';
                    })
                    .catch(function (e) {
                        skel.style.display = 'none';
                        errEl.innerHTML = '<div class="noc-empty-icon">⚠</div><p>No se pudo cargar las métricas.</p>';
                        errEl.style.display = 'block';
                    });
            }

            if (loadBtn) loadBtn.addEventListener('click', load);
            if (deviceEl) deviceEl.addEventListener('change', function () { if (deviceEl.value) load(); });
            if (deviceEl && deviceEl.value) load();
        })();
    </script>
}