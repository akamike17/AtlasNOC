@model AtlasNOC.Application.Dtos.InterfaceDto
@{
    ViewData["Title"] = "Interfaz — " + Model.Name;
    var operBadge = Model.OperStatus == 1 ? "bg-up" : Model.OperStatus == 0 ? "bg-down" : "bg-unknown";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@Model.Name</h1>
    <span class="badge @operBadge">@((AtlasNOC.Domain.Enums.InterfaceOperStatus)Model.OperStatus)</span>
</div>

<div class="noc-card mb-3">
    <dl class="row mb-0">
        <dt class="col-sm-2">IfIndex</dt><dd class="col-sm-10">@Model.IfIndex</dd>
        <dt class="col-sm-2">Descripción</dt><dd class="col-sm-10">@(Model.Description ?? "—")</dd>
        <dt class="col-sm-2">MAC</dt><dd class="col-sm-10">@(Model.MacAddress ?? "—")</dd>
        <dt class="col-sm-2">IP</dt><dd class="col-sm-10">@(Model.IpAddress ?? "—")</dd>
        <dt class="col-sm-2">Admin</dt><dd class="col-sm-10">@((AtlasNOC.Domain.Enums.InterfaceAdminStatus)Model.AdminStatus)</dd>
        <dt class="col-sm-2">Velocidad</dt><dd class="col-sm-10">@(Model.SpeedBps?.ToString("N0") ?? "—")</dd>
        <dt class="col-sm-2">Tipo</dt><dd class="col-sm-10">@(Model.InterfaceType ?? "—")</dd>
        <dt class="col-sm-2">Última vez visto</dt><dd class="col-sm-10">@(Model.LastSeenAtUtc?.ToLocalTime().ToString("g") ?? "—")</dd>
        <dt class="col-sm-2">Enlaces</dt><dd class="col-sm-10">@Model.LinkCount</dd>
    </dl>
</div>

<div class="mb-3">
    <a asp-controller="Devices" asp-action="Detail" asp-route-id="@Model.DeviceId" class="btn btn-outline-secondary btn-sm">Volver al dispositivo</a>
    <a asp-controller="Metrics" asp-action="Interface" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">Ver métricas</a>
</div>