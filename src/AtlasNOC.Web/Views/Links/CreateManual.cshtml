@model AtlasNOC.Application.Dtos.CreateManualLinkRequest
@{
    ViewData["Title"] = "Crear enlace manual";
}

<h1 class="h4 mb-3">Crear enlace manual</h1>

<div class="noc-card" style="max-width:640px">
    <form asp-action="CreateManual" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label class="form-label">Interface A (GUID)</label>
            <input asp-for="AInterfaceId" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Interface B (GUID)</label>
            <input asp-for="BInterfaceId" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Tipo</label>
            <select asp-for="LinkType" class="form-select"
                    asp-items="Html.GetEnumSelectList<AtlasNOC.Domain.Enums.LinkType>()"></select>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm">Crear</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancelar</a>
        </div>
    </form>
</div>

<p class="text-secondary small mt-3">La relación manual se marca con <code>DiscoverySource = Manual</code>
    y queda confirmada por intervención humana (no se rechaza automáticamente).</p>