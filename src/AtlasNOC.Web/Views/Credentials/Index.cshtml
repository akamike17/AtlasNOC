@model IReadOnlyList<AtlasNOC.Application.Services.CredentialDto>
@{
    ViewData["Title"] = "Credenciales";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Credenciales de equipos</h1>
    <a asp-action="Create" class="btn btn-primary btn-sm">Nueva credencial</a>
</div>

<div class="noc-card">
    <table class="table table-dark table-sm align-middle mb-0">
        <thead><tr><th>Nombre</th><th>Versión SNMP</th><th>Estado</th></tr></thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="3" class="text-secondary">Sin credenciales. Los secretos se guardan cifrados y nunca se muestran.</td></tr>
        }
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@((AtlasNOC.Domain.Enums.SnmpVersion)c.SnmpVersion)</td>
                <td>
                    @if (c.IsActive)
                    {
                        <span class="badge bg-up">Activa</span>
                    }
                    else
                    {
                        <span class="badge bg-down">Inactiva</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>