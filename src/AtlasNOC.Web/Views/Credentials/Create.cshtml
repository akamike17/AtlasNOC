@model AtlasNOC.Application.Services.CreateCredentialRequest
@{
    ViewData["Title"] = "Nueva credencial";
}

<div class="noc-card" style="max-width:560px">
    <h1 class="h5 mb-3">Nueva credencial</h1>
    <p class="text-secondary small">Los secretos (community/passwords) se guardan cifrados y no se vuelven a mostrar.</p>
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label" asp-for="Name">Nombre</label>
            <input class="form-control bg-dark text-light" asp-for="Name" required />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="SnmpVersion">Versión SNMP</label>
            <select class="form-select bg-dark text-light" asp-for="SnmpVersion">
                <option value="0">v2c</option>
                <option value="1">v3</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="UserName">Usuario (SNMPv3)</label>
            <input class="form-control bg-dark text-light" asp-for="UserName" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Community">Community (SNMPv2c)</label>
            <input class="form-control bg-dark text-light" asp-for="Community" type="password" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="AuthProtocol">Protocolo de autenticación (SNMPv3)</label>
            <input class="form-control bg-dark text-light" asp-for="AuthProtocol" placeholder="SHA / MD5" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="AuthPassword">Password de autenticación</label>
            <input class="form-control bg-dark text-light" asp-for="AuthPassword" type="password" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="PrivProtocol">Protocolo de privacidad (SNMPv3)</label>
            <input class="form-control bg-dark text-light" asp-for="PrivProtocol" placeholder="AES / DES" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="PrivPassword">Password de privacidad</label>
            <input class="form-control bg-dark text-light" asp-for="PrivPassword" type="password" />
        </div>
        <button class="btn btn-primary" type="submit">Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>