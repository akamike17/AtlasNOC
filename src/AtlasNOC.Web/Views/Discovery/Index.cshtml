@model IReadOnlyList<AtlasNOC.Application.Dtos.DiscoveryRunDto>
@{
    ViewData["Title"] = "Descubrimiento";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Descubrimiento</h1>
    <div class="d-flex gap-2">
        <form asp-action="DetectLocalNetwork" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button class="btn btn-success btn-sm" type="submit">Detectar mi red</button>
        </form>
        <a asp-action="Start" class="btn btn-primary btn-sm">Nuevo descubrimiento</a>
    </div>
</div>

@if (TempData["DiscoveryInfo"] is string info)
{
    <div class="alert alert-info">@info</div>
}
@if (TempData["DiscoveryError"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<div class="alert alert-secondary small">
    El modo automático usa la interfaz IPv4 activa y realiza consultas de sólo lectura.
    Puede ver equipos de la LAN; redes detrás de NAT, VLAN o enlaces WISP requieren un conector autorizado.
    SNMP mejora la identificación, pero no es obligatorio para registrar presencia detectada.
</div>

<div class="noc-card">
    <table class="table table-dark table-sm align-middle mb-0">
        <thead><tr><th>Alcance</th><th>Estado</th><th>Inicio</th><th>Encontrados</th><th>Nuevos</th><th>Enlaces</th><th>Fallos</th></tr></thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-secondary">Sin ejecuciones. Inicia el primero.</td></tr>
        }
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.ScopeIp</td>
                <td>@((AtlasNOC.Domain.Enums.DiscoveryRunStatus)r.Status)</td>
                <td>@r.StartedAtUtc.ToLocalTime().ToString("g")</td>
                <td>@r.FoundCount</td>
                <td>@r.NewCount</td>
                <td>@r.ConfirmedLinkCount</td>
                <td>@r.FailureCount</td>
            </tr>
        }
        </tbody>
    </table>
</div>
