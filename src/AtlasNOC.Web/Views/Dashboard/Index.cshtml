@model AtlasNOC.Application.Dtos.SystemHealthDto
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">Dashboard</h1>
    <a asp-controller="Sites" asp-action="Create" class="btn btn-primary btn-sm">Agregar sitio</a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="noc-card">
            <div class="text-secondary small">Dispositivos</div>
            <div class="display-6">@Model.DeviceCount</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="noc-card">
            <div class="text-secondary small">Alertas abiertas</div>
            <div class="display-6">@Model.OpenAlertCount</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="noc-card">
            <div class="text-secondary small">Base de datos</div>
            <div class="display-6">
                @if (Model.DatabaseOk) { <span class="badge bg-up">OK</span> }
                else { <span class="badge bg-down">ERROR</span> }
            </div>
        </div>
    </div>
</div>

<p class="text-secondary small mt-4">Agrega un sitio y descubre tu red para comenzar a construir la topología.</p>

<div class="noc-card mt-3">
    <h2 class="h6">Asistente de puesta en marcha</h2>
    <p class="small text-secondary mb-2">AtlasNOC empieza en modo lectura y sólo usa canales que tú autorices.</p>
    <div class="small mb-2">
        <span class="badge text-bg-success">Listo</span> Web, Worker y base de datos
    </div>
    @if (((IReadOnlyList<AtlasNOC.Application.Services.LocalNetworkProfileDto>)ViewBag.LocalProfiles).Count > 0)
    {
        <div class="small mb-2">
            <span class="badge text-bg-success">Detectable</span> Red local encontrada automáticamente
        </div>
    }
    else
    {
        <div class="small mb-2">
            <span class="badge text-bg-warning">Revisión</span> No hay interfaz IPv4 activa con gateway
        </div>
    }
    <div class="small mb-3">
        <span class="badge text-bg-secondary">Opcional</span> SNMP/API/RADIUS sólo para enriquecer o consultar segmentos autorizados
    </div>
    <a asp-controller="Discovery" asp-action="Start" class="btn btn-success btn-sm">Descubrir mi red</a>
    <a asp-controller="Integrations" asp-action="Index" class="btn btn-outline-secondary btn-sm">Ver integraciones</a>
</div>

<div class="noc-card mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h6 mb-0">Mi red</h2>
        <span class="small text-secondary">Topología observada</span>
    </div>
    <div id="topology-map" style="height:520px" aria-label="Mapa de mi red"></div>
    <div id="topology-map-count" class="small text-secondary mt-2"></div>
    <div id="topology-map-empty" class="alert alert-secondary mt-2 mb-0" hidden></div>
    <div id="topology-map-detail" class="small mt-2" aria-live="polite">Selecciona un dispositivo para ver sus datos.</div>
    <p class="small text-secondary mt-2 mb-0">Sólo se muestran equipos inventariados y relaciones respaldadas por evidencia.</p>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/cytoscape@3.30.3/dist/cytoscape.min.js"></script>
    <script src="~/js/topology.js" asp-append-version="true"></script>
    <script>
      window.atlasTopology = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Topology, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
      if (window.renderTopology) window.renderTopology('topology-map', window.atlasTopology);
    </script>
}
