@model AtlasNOC.Application.Dtos.DeviceDto
@{
    ViewData["Title"] = "Dispositivo — " + Model.Hostname;
    var status = (AtlasNOC.Domain.Enums.DeviceStatus)Model.Status;
    var badge = Model.Status == 1 ? "bg-up" : Model.Status == 2 ? "bg-down" : "bg-unknown";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@Model.Hostname</h1>
    <span class="badge @badge">@status</span>
</div>

<div class="noc-card mb-3">
    <dl class="row mb-0">
        <dt class="col-sm-2">IP gestión</dt><dd class="col-sm-10">@Model.ManagementIp</dd>
        <dt class="col-sm-2">Tipo</dt><dd class="col-sm-10">@((AtlasNOC.Domain.Enums.DeviceType)Model.DeviceType)</dd>
        <dt class="col-sm-2">Vendor</dt><dd class="col-sm-10">@((AtlasNOC.Domain.Enums.Vendor)Model.Vendor)</dd>
        <dt class="col-sm-2">Modelo</dt><dd class="col-sm-10">@(Model.Model ?? "—")</dd>
        <dt class="col-sm-2">Última vez visto</dt><dd class="col-sm-10">@(Model.LastSeenAtUtc?.ToLocalTime().ToString("g") ?? "—")</dd>
        <dt class="col-sm-2">Gestionado</dt><dd class="col-sm-10">@(Model.IsManaged ? "Sí" : "No")</dd>
    </dl>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="noc-card">
            <h2 class="h6">Latencia (RTT)</h2>
            <canvas id="chartRtt" height="120"></canvas>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="noc-card">
            <h2 class="h6">CPU</h2>
            <canvas id="chartCpu" height="120"></canvas>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var deviceId = '@Model.Id';
            async function fetchSeries(metric) {
                var resp = await fetch('/api/metrics?resourceType=Device&resourceId=' + deviceId + '&metric=' + metric);
                if (!resp.ok) return [];
                var pts = await resp.json();
                return pts.map(function (p) { return { x: new Date(p.timestampUtc), y: p.value }; });
            }
            function render(elId, label, data, color) {
                var el = document.getElementById(elId);
                if (!el) return;
                new Chart(el, {
                    type: 'line',
                    data: { datasets: [{ label: label, data: data, borderColor: color, backgroundColor: color + '22', tension: 0.2, pointRadius: 0, fill: true }] },
                    options: {
                        animation: false,
                        scales: {
                            x: { type: 'time', time: { unit: 'hour' }, grid: { color: '#30363d' }, ticks: { color: '#8b949e' } },
                            y: { grid: { color: '#30363d' }, ticks: { color: '#8b949e' } }
                        },
                        plugins: { legend: { labels: { color: '#e6edf3' } } }
                    }
                });
            }
            Promise.all([
                fetchSeries('rtt').then(function (d) { render('chartRtt', 'RTT (ms)', d, '#58a6ff'); }),
                fetchSeries('cpu_usage').then(function (d) { render('chartCpu', 'CPU (%)', d, '#f97316'); })
            ]).catch(function (e) { console.error(e); });
        })();
    </script>
}