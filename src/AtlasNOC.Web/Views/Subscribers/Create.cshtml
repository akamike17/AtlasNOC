@model AtlasNOC.Application.Dtos.CreateSubscriberRequest
@{
    ViewData["Title"] = "Nuevo suscriptor";
    var sites = ViewBag.Sites as IReadOnlyList<AtlasNOC.Application.Dtos.SiteDto>;
}

<h1 class="h4 mb-3">Nuevo suscriptor</h1>

<div class="noc-card" style="max-width:640px">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Sitio</label>
            <select asp-for="SiteId" class="form-select">
                <option value="">Sin sitio</option>
                @if (sites is not null)
                {
                    foreach (var s in sites)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                }
            </select>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm">Crear</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancelar</a>
        </div>
    </form>
</div>