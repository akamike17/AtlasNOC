@{
    ViewData["Title"] = "API Keys";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">API Keys (Integraciones)</h1>
    <a asp-action="Create" class="btn btn-primary btn-sm">Nueva API key</a>
</div>

@if (TempData["NewKey"] is string newKey)
{
    <div class="alert alert-warning noc-card">
        <strong>Guarda esta key ahora — no se volverá a mostrar.</strong>
        <p class="mb-2">Nombre: @TempData["NewKeyName"]</p>
        <code class="d-block p-2 bg-dark text-light rounded">@newKey</code>
        <small class="d-block mt-2 text-secondary">Solo se almacena el hash en la base de datos. Si la pierdes, deberás crear otra y revocar esta.</small>
    </div>
}

<div class="noc-card">
    <table class="table table-dark table-sm align-middle mb-0">
        <thead><tr><th>Nombre</th><th>Descripción</th><th>Scopes</th><th>Estado</th><th>Creada</th><th>Expira</th><th></th></tr></thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-secondary">Sin API keys. Las claves son solo para integraciones externas, nunca para login humano.</td></tr>
        }
        @foreach (var k in Model)
        {
            <tr>
                <td>@k.Name</td>
                <td>@(k.Description ?? "—")</td>
                <td><code>@(k.Scopes ?? "—")</code></td>
                <td>
                    @if (k.IsActive)
                    {
                        <span class="badge bg-up">Activa</span>
                    }
                    else
                    {
                        <span class="badge bg-down">Revocada / Expirada</span>
                    }
                </td>
                <td>@k.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                <td>@(k.ExpiresAtUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                <td>
                    @if (k.IsActive)
                    {
                        <form asp-action="Revoke" asp-route-id="@k.Id" method="post" onsubmit="return confirm('¿Revocar esta API key?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Revocar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>