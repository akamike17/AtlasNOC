@model AtlasNOC.Application.Dtos.TopologyGraphDto
@{ ViewData["Title"] = "Topología"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h4 mb-0">Topología</h1><div class="d-flex gap-2"><select id="siteFilter" class="form-select form-select-sm bg-dark text-light"><option value="">Todos los sitios</option>@foreach(var g in Model.Groups){<option value="@g.SiteId">@g.Label</option>}</select><button id="refreshBtn" class="btn btn-outline-light btn-sm">Recargar</button></div></div>
<div class="noc-card"><div id="cy" style="height:70vh" aria-label="Mapa de topología"></div><div id="cy-count" class="small text-secondary mt-2"></div><div id="cy-empty" class="alert alert-secondary mt-2 mb-0" hidden></div><div id="cy-detail" class="small mt-2" aria-live="polite">Selecciona un dispositivo para ver sus datos.</div></div>
<div class="small text-secondary mt-2">Estados: <span class="text-success">● Up</span> <span class="text-danger">● Down</span> <span class="text-warning">● Mantenimiento</span> <span class="text-secondary">● Inalcanzable</span> · línea discontinua = no confirmado</div>
@section Scripts { <script src="~/lib/cytoscape/cytoscape.min.js" asp-append-version="true"></script><script src="~/js/topology.js" asp-append-version="true"></script> }
