@model AtlasNOC.Application.Dtos.TopologyGraphDto
@{ ViewData["Title"] = "Topología"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h4 mb-0">Topología</h1><a asp-controller="Topology" asp-action="Index" class="btn btn-outline-light btn-sm">Recargar</a></div>
<div class="noc-card"><div id="cy" style="height:70vh" aria-label="Mapa de topología"></div><div id="cy-count" class="small text-secondary mt-2"></div><div id="cy-empty" class="alert alert-secondary mt-2 mb-0" hidden></div><div id="cy-detail" class="small mt-2" aria-live="polite">Selecciona un dispositivo para ver sus datos.</div></div>
@section Scripts { <script src="https://cdn.jsdelivr.net/npm/cytoscape@3.30.3/dist/cytoscape.min.js"></script><script src="~/js/topology.js" asp-append-version="true"></script><script>window.renderTopology('cy', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })));</script> }
