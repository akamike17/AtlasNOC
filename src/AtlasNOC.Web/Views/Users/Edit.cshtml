@model EditUserRequest
@{ ViewData["Title"] = "Editar usuario"; }
<div class="noc-card" style="max-width:560px">
    <h1 class="h5 mb-3">Editar usuario</h1>
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label class="form-label">Usuario / correo</label><input asp-for="UserName" class="form-control bg-dark text-light mb-3" />
        <label class="form-label">Nombre</label><input asp-for="DisplayName" class="form-control bg-dark text-light mb-3" />
        <button class="btn btn-primary">Guardar</button> <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
