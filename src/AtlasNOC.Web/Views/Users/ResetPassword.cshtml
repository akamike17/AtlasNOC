@model ResetUserPasswordRequest
@{ ViewData["Title"] = "Restablecer contraseña"; }
<div class="noc-card" style="max-width:560px">
    <h1 class="h5 mb-3">Restablecer contraseña</h1>
    <form asp-action="ResetPassword" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label class="form-label">Nueva contraseña</label><input asp-for="NewPassword" type="password" class="form-control bg-dark text-light mb-3" />
        <label class="form-label">Confirmar contraseña</label><input asp-for="ConfirmPassword" type="password" class="form-control bg-dark text-light mb-3" />
        <button class="btn btn-warning">Restablecer</button> <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
