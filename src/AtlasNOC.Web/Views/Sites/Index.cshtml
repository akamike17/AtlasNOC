@model IReadOnlyList<AtlasNOC.Application.Dtos.SiteDto>
@{
    ViewData["Title"] = "Sitios / Torres";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Sitios / Torres</h1>
    <a asp-action="Create" class="btn btn-primary btn-sm">Nuevo sitio</a>
</div>

<div class="noc-card">
    <table class="table table-dark table-sm align-middle mb-0">
        <thead><tr><th>Nombre</th><th>Código</th><th>Tipo</th><th>Dispositivos</th></tr></thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-secondary">Sin sitios. Crea el primero.</td></tr>
        }
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.Code</td>
                <td>@s.SiteType</td>
                <td>@s.DeviceCount</td>
            </tr>
        }
        </tbody>
    </table>
</div>