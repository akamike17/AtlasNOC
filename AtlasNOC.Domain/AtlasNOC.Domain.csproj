<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <RootNamespace>AtlasNOC.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core core (DbContext, DbSet, etc.) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.13" />
    <!-- MySQL provider (Pomelo — bien soportado con .NET 8) -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
    <!-- Migrations support (para EnsureCreated y basilar) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.13" />
    <!-- Extensiones de conversión de GUID/cadenas para value objects -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.13"
        PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Lextm.SharpSnmpLib" Version="12.5.7" />
    <!-- Data Protection for credential encryption -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

</Project>
