# AtlasNOC Production Environment Variables
# Copy to .env.production and fill in all values
# NEVER commit this file to version control!

# ─── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD
MYSQL_CONNECTION_STRING=Server=mysql;Port=3306;Database=atlasnoc;User=atlasnoc;Password=${MYSQL_PASSWORD};SslMode=Required;CertificateStoreLocation=CurrentUser;ConnectionTimeout=30;DefaultCommandTimeout=30;

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_CONNECTION_STRING=redis:6379,password=${REDIS_PASSWORD},ssl=False,abortConnect=False,connectTimeout=5000,syncTimeout=5000

# ─── Data Protection (required for Linux/Docker Production) ──────────────────
# Absolute host path to a private PFX file. Keep the certificate outside the repo.
DATA_PROTECTION_CERTIFICATE_PATH=CHANGE_ME_ABSOLUTE_PATH_TO_PFX
DATA_PROTECTION_CERTIFICATE_PASSWORD=CHANGE_ME_STRONG_PFX_PASSWORD

# ─── Seq Logging ──────────────────────────────────────────────────────────────
SEQ_API_KEY=CHANGE_ME_SEQ_API_KEY

# ─── NVD CVE API ──────────────────────────────────────────────────────────────
NVD_API_KEY=CHANGE_ME_NVD_API_KEY

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN_1=https://your-domain.com
CORS_ORIGIN_2=https://admin.your-domain.com

# ─── One-time administrator bootstrap ─────────────────────────────────────────
# Remove these variables immediately after the first successful startup.
AtlasNoc__BootstrapAdminApiKey=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
AtlasNoc__BootstrapAdminOwner=initial-admin

# ─── Docker Image ─────────────────────────────────────────────────────────────
IMAGE_TAG=latest

# ─── Optional: External Services ──────────────────────────────────────────────
# TEMPO_ENDPOINT=http://tempo:4317
# GRAFANA_ENDPOINT=http://grafana:3000
